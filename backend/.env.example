APP_ENV=development
DEPLOYMENT_BOOTSTRAP_RELEASE=engineering-local
# Isolated installation setup only; production follows its approved onboarding plan.
DEPLOYMENT_PHASE=onboarding
LOCAL_CREDENTIAL_MODE=generated
KNOWN_LOCAL_CREDENTIAL_RISK_ACCEPTED=false
ONBOARDING_ADMIN_ALLOW_CIDR=127.0.0.1/32
OPENSEARCH_ADMIN_USERNAME=admin
OPENSEARCH_ADMIN_PASSWORD=<independent-admin-password>
NEO4J_ADMIN_USERNAME=neo4j
NEO4J_ADMIN_PASSWORD=<independent-admin-password>
# Set true only after accepting the Community edition's admin-equivalent account.
NEO4J_COMMUNITY_ADMIN_EQUIVALENT_ACCEPTED=false
MIGRATION_REQUIRED_VERSION=058
MIGRATION_REQUIRED_CHECKSUM=480069758
MIGRATION_BASELINE_CHECKSUM=
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=DEBUG
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=https://nomosmart.local
FRONTEND_APP_ORIGIN=https://nomosmart.local

DATABASE_URL=postgresql+psycopg2://nomosmart:<url-encoded-password>@127.0.0.1:5432/nomosmart?sslmode=verify-full&sslrootcert=<absolute-ca-path>
REDIS_TLS_CA_CERT_PATH=<absolute-ca-path>
REDIS_URL=rediss://nomosmart:<url-encoded-password>@127.0.0.1:6379/0?ssl_cert_reqs=required&ssl_check_hostname=true&ssl_ca_certs=<absolute-ca-path>
CELERY_BROKER_URL=rediss://nomosmart:<url-encoded-password>@127.0.0.1:6379/0?ssl_cert_reqs=required&ssl_check_hostname=true&ssl_ca_certs=<absolute-ca-path>
CELERY_RESULT_BACKEND=rediss://nomosmart:<url-encoded-password>@127.0.0.1:6379/1?ssl_cert_reqs=required&ssl_check_hostname=true&ssl_ca_certs=<absolute-ca-path>

S3_ENDPOINT_URL=https://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=nomosmart
S3_ACCESS_KEY_ID=<secret>
S3_SECRET_ACCESS_KEY=<secret>
S3_USE_SSL=true
S3_VERIFY_TLS=true
S3_PATH_STYLE_ACCESS=true
S3_CA_CERT_PATH=<absolute-ca-path>

OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USERNAME=nomosmart
OPENSEARCH_PASSWORD=<secret>
OPENSEARCH_VERIFY_TLS=true
OPENSEARCH_INDEX_PREFIX=nomosmart-dev
OPENSEARCH_STAGING_LIVE_WRITE=true
OPENSEARCH_CA_CERT_PATH=<absolute-ca-path>

NEO4J_URI=bolt+s://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=nomosmart
NEO4J_PASSWORD=<secret>
NEO4J_CA_CERT_PATH=<absolute-ca-path>

# OIDC_CLIENT_SECRET_FILE=<absolute-private-client-secret-file> # only if the OIDC client requires it
SSL_CERT_FILE=<absolute-path-to-required-ca-bundle.crt>
BREAK_GLASS_USERNAME=nomosmart
BREAK_GLASS_RUNBOOK_URI=https://runbooks.example.test/nomosmart/break-glass
BREAK_GLASS_ALERTING_EVIDENCE=ops-alert-route
IDENTITY_SYNC_SCHEDULE=0 2 * * *
IDENTITY_SYNC_TIMEZONE=Asia/Taipei
IDENTITY_SYNC_ENABLED=true
IDENTITY_SYNC_SCOPE=people_and_groups
IDENTITY_SYNC_QUEUE_TIMEOUT_SECONDS=300
IDENTITY_SYNC_RUN_TIMEOUT_SECONDS=1800
IDENTITY_SYNC_HEARTBEAT_SECONDS=30

APP_ENCRYPTION_KEY=<64-character-hex-key>
DEFAULT_TIMEZONE=Asia/Taipei
NOMOSMART_DOCUMENT_MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_SIZE_MB=100
STAGING_INDEX_TTL_DAYS=7
INGESTION_WORKER_LEASE_SECONDS=300
TARGET_CHUNK_TOKENS=500
MAX_CHUNK_TOKENS=700
MIN_CHUNK_TOKENS=80
CHUNK_OVERLAP_TOKENS=60
HEADING_CONTEXT_ENABLED=true
MAX_HEADING_DEPTH=4
MAX_CONTEXT_PREFIX_TOKENS=96
DOCUMENT_TITLE_CONTEXT_ENABLED=true
TABLE_CHUNK_MAX_ROWS=10
REMOVE_REPEATED_HEADER_FOOTER=true
HTTP_SOURCE_ALLOWED_HOSTS=
HTTP_SOURCE_ALLOWED_CIDRS=
SFTP_KNOWN_HOSTS_PATH=/etc/nomosmart/ssh_known_hosts
# Optional additional public enterprise CA; FTPS always verifies certificates and hostnames.
FTPS_CA_CERT_PATH=
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_API_INVALID_AUTH_REQUESTS_PER_MINUTE=20
PUBLIC_API_IDEMPOTENCY_TTL_HOURS=24
PUBLIC_API_IDEMPOTENCY_LEASE_SECONDS=300
PUBLIC_API_CONTENT_RETENTION_DAYS=30
PUBLIC_API_RECORD_RETENTION_DAYS=365

# Non-sensitive bootstrap input; active settings and encrypted credentials live in DB.
AUTH_BOOTSTRAP_CONFIGURATION=<absolute-path-to-non-secret-bootstrap-json>
AUTH_ENDPOINT_ALLOWED_HOSTS=directory.example.invalid,login.example.invalid
AUTH_ENDPOINT_ALLOWED_CIDRS=
AUTH_TRUST_ROOT=<absolute-path-to-directory-ca-folder>
AUTH_ENCRYPTION_KEY_ID=auth-v1
# AUTH_ENCRYPTION_PREVIOUS_KEYS_FILE=<absolute-private-previous-keyring-json>
AUTH_EMERGENCY_USERNAME=emergency-admin

# Real operator-provided directory Bind credential; never a generated replacement.
DIRECTORY_BIND_PASSWORD_FILE=<absolute-private-bind-password-file>
# Optional dedicated auth key; omit to use the initial APP_ENCRYPTION_KEY fallback.
# AUTH_ENCRYPTION_KEY_FILE=<absolute-private-64-hex-auth-key-file>

# Database pool and server-side limits (0 = PostgreSQL default, no limit).
# Chat turns hold a transaction across the Chat Model call; an idle-in-transaction
# limit must exceed the longest provider timeout.
NOMOSMART_DB_POOL_SIZE=10
NOMOSMART_DB_MAX_OVERFLOW=20
NOMOSMART_DB_POOL_TIMEOUT_SECONDS=30
NOMOSMART_DB_STATEMENT_TIMEOUT_MS=0
NOMOSMART_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=0
# Late-acknowledged worker tasks running longer than this are redelivered.
NOMOSMART_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
# Soft time limit for scheduling/maintenance tasks; hard limit is +30 s. 0 = none.
NOMOSMART_CELERY_SHORT_TASK_SOFT_TIME_LIMIT_SECONDS=300
# Soft limit for long work tasks (OCR, directory sync, validation...). 0 = none.
NOMOSMART_CELERY_LONG_TASK_SOFT_TIME_LIMIT_SECONDS=0
