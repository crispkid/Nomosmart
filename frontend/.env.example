NEXT_PUBLIC_APP_ORIGIN=https://nomosmart.local
NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_INTERNAL_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional operator CA bundle for a private HTTPS backend.
# OIDC discovery, token exchange and client secrets belong to the backend.
# Export before starting Node; .env.local alone is too late for Node TLS trust.
# export NODE_EXTRA_CA_CERTS=/absolute/path/to/backend-ca-bundle.crt

# Unified feedback: duration 3000..20000 ms, visible 1..3, recent 1..100.
FRONTEND_FEEDBACK_TOAST_DURATION_MS=5000
FRONTEND_FEEDBACK_TOAST_VISIBLE_LIMIT=2
FRONTEND_FEEDBACK_RECENT_LIMIT=20

# Memory-only graph initial-layout cache; zero disables it.
FRONTEND_GRAPH_LAYOUT_CACHE_MAX_ENTRIES=8
FRONTEND_GRAPH_LAYOUT_CACHE_MAX_NODES=8000
