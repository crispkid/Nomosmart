{
  "name": "nomosmart-frontend",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "i18n:ast": "eslint src --max-warnings 0",
    "test": "npm run test:contracts && npm run test:geometry && npm run test:components",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:components": "node node_modules/vitest/vitest.mjs run",
    "test:geometry": "node tests/chg294SelectionGeometry.browser.mjs",
    "test:coverage": "npm run test:contracts && npm run test:geometry && node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node tests/e2eLive.mjs"
  },
  "dependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "d3-force": "^3.0.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.7",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "undici": "7.29.0"
  }
}
