#!/bin/sh
set -eu
if ! command -v python3 >/dev/null 2>&1; then
  echo 'Python 3.11 or newer is required.' >&2
  exit 2
fi
if ! python3 -B -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 2)'; then
  echo 'Python 3.11 or newer is required.' >&2
  exit 2
fi
NOMOSMART_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec python3 -B "$NOMOSMART_ROOT/deploy/docker/nomosmart_cli.py" "$@"
