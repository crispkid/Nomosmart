#!/usr/bin/env sh
set -eu
set +x

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
tls_dir="$repository_root/deploy/docker/generated/current/tls/active"

for name in edge.crt edge.key edge-ca.crt rustfs.crt rustfs.key rustfs-ca.crt opensearch.crt opensearch.key opensearch-ca.crt; do
  if [ ! -f "$tls_dir/$name" ]; then
    echo "TLS is now generated by nomosmart-package init; initialize the Secret package first" >&2
    exit 66
  fi
done

echo "TLS material already exists in the current package generation."
