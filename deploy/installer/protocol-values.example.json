{
  "deploymentProfile": "external-services",
  "storageValidation": {
    "mode": "external"
  },
  "secrets": {
    "existingSecret": "nomosmart-runtime-secrets",
    "data": {}
  },
  "postgresql": {
    "mode": "external",
    "operator": {
      "enabled": false
    },
    "external": {
      "host": "postgresql.external.example.test",
      "port": 5432,
      "caSecretName": "external-postgresql-ca",
      "caKey": "ca.crt"
    },
    "backup": {
      "enabled": false
    }
  },
  "migration": {
    "jdbcUrl": "jdbc:postgresql://postgresql.external.example.test:5432/nomosmart?sslmode=verify-full&sslrootcert=/etc/nomosmart/tls/postgresql-ca.crt"
  },
  "redis": {
    "mode": "external",
    "cluster": {
      "enabled": false
    },
    "external": {
      "url": "rediss://redis.external.example.test:6379",
      "caSecretName": "external-redis-ca",
      "caKey": "ca.crt"
    }
  },
  "rustfs": {
    "mode": "external",
    "cluster": {
      "enabled": false
    },
    "external": {
      "url": "https://s3.external.example.test",
      "caSecretName": "external-rustfs-ca",
      "caKey": "ca.crt"
    }
  },
  "opensearch": {
    "mode": "external",
    "external": {
      "url": "https://opensearch.external.example.test:9200",
      "caSecretName": "external-opensearch-ca",
      "caKey": "ca.crt"
    }
  },
  "neo4j": {
    "mode": "external",
    "external": {
      "uri": "neo4j+s://neo4j.external.example.test:7687",
      "caSecretName": "external-neo4j-ca",
      "caKey": "ca.crt"
    }
  },
  "bootstrap": {
    "deploymentPhase": "onboarding",
    "onboardingAdminAllowCidr": "127.0.0.1/32"
  },
  "backend": {
    "env": {
      "REDIS_HA_MODE": "standalone",
      "REDIS_TLS_CA_CERT_PATH": "/etc/nomosmart/tls/redis-ca.crt",
      "S3_USE_SSL": "true",
      "S3_VERIFY_TLS": "true",
      "OPENSEARCH_VERIFY_TLS": "true",
      "FRONTEND_APP_ORIGIN": "https://nomosmart.example.invalid",
      "CORS_ALLOWED_ORIGINS": "https://nomosmart.example.invalid"
    }
  },
  "image": {
    "frontend": {
      "repository": "registry.example.invalid/nomosmart/frontend",
      "tag": "REPLACE_WITH_REVIEWED_AUTH_CONTRACT_2_TAG",
      "pullPolicy": "IfNotPresent"
    },
    "backend": {
      "repository": "registry.example.invalid/nomosmart/backend",
      "tag": "REPLACE_WITH_REVIEWED_AUTH_CONTRACT_2_TAG",
      "pullPolicy": "IfNotPresent"
    }
  },
  "global": {
    "publicHost": "nomosmart.example.invalid",
    "publicOrigin": "https://nomosmart.example.invalid"
  },
  "authentication": {
    "contractRevision": 2,
    "endpointAllowedHosts": "directory.example.invalid",
    "endpointAllowedCidrs": "",
    "encryptionKeyId": "auth-v1",
    "caSecretName": "nomosmart-directory-ca",
    "bootstrapConfiguration": {
      "configuration": {
        "auth_mode": "ldap",
        "display_name": "Enterprise sign-in",
        "directory": {
          "source_id": "00000000-0000-4000-8000-000000000001",
          "name": "Enterprise directory",
          "schema_type": "ldap",
          "endpoints": [
            "ldaps://directory.example.invalid:636"
          ],
          "ca_reference": "enterprise-ca.pem",
          "users_dn": "ou=users,dc=example,dc=invalid",
          "groups_dn": "ou=groups,dc=example,dc=invalid",
          "bind_dn": "cn=nomosmart-reader,ou=services,dc=example,dc=invalid"
        },
        "sync_enabled": true,
        "sync_scope": "people_and_groups",
        "sync_schedule": "0 2 * * *",
        "timezone": "Asia/Taipei"
      },
      "admin_group_id": "00000000-0000-4000-8000-000000000002"
    }
  },
  "ingress": {
    "hosts": [
      {
        "host": "nomosmart.example.invalid",
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "service": "frontend"
          }
        ]
      }
    ],
    "tls": [
      {
        "secretName": "nomosmart-ingress-tls",
        "hosts": [
          "nomosmart.example.invalid"
        ]
      }
    ]
  }
}
