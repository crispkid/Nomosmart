{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "source-tcp-gateway",
        "namespace": "<dedicated-dependency-namespace>"
      },
      "data": {
        "nginx.conf": "pid /tmp/nginx.pid;\nevents {}\nstream {\n error_log /dev/stderr;\nserver { listen 15432; proxy_connect_timeout 10s; proxy_timeout 600s; proxy_pass <postgresql-ip>:5432; }\nserver { listen 16379; proxy_connect_timeout 10s; proxy_timeout 600s; proxy_pass <redis-primary-ip>:6379; }\nserver { listen 19000; proxy_connect_timeout 10s; proxy_timeout 600s; proxy_pass <rustfs-ip>:9000; }\nserver { listen 19200; proxy_connect_timeout 10s; proxy_timeout 600s; proxy_pass <opensearch-ip>:9200; }\nserver { listen 17687; proxy_connect_timeout 10s; proxy_timeout 600s; proxy_pass <neo4j-ip>:7687; }\nserver { listen 18443; proxy_connect_timeout 10s; proxy_timeout 600s; proxy_pass <keycloak-ip>:443; }\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "source-tcp-gateway",
        "namespace": "<dedicated-dependency-namespace>"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "source-tcp-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "source-tcp-gateway"
            }
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 101,
              "runAsGroup": 101,
              "fsGroup": 101
            },
            "containers": [
              {
                "name": "nginx",
                "image": "nginx:1.27.5-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10",
                "command": [
                  "nginx",
                  "-g",
                  "daemon off;"
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 15432
                  },
                  "periodSeconds": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "source-tcp-gateway"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    }
  ]
}
