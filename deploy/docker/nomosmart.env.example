# NomoSmart Docker Compose environment template.
# This file contains non-sensitive settings only. Use deploy/package/nomosmart-package
# to create deploy/docker/nomosmart.env plus mode-0600 files under generated/current.

COMPOSE_PROJECT_NAME=nomosmart
COMPOSE_PROFILES=postgresql,redis,rustfs,opensearch,neo4j,keycloak

# Pinned images and single public edge
EDGE_IMAGE=nginx:1.27.5-alpine
FRONTEND_IMAGE=nomosmart/frontend:0.1.0
BACKEND_IMAGE=nomosmart/backend:0.1.0
MIGRATION_IMAGE=nomosmart/migrations:0.1.0
POSTGRES_IMAGE=nomosmart/postgresql:18.4
REDIS_IMAGE=redis:7.4.2-alpine
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.1
NEO4J_IMAGE=neo4j:5.26.4-community
RUSTFS_IMAGE=nomosmart/rustfs:1.0.0-beta.10
KEYCLOAK_IMAGE=nomosmart/keycloak:26.0.8
DEBUG_PROXY_IMAGE=alpine/socat:1.8.0.1
NOMOSMART_PUBLIC_HOST=nomosmart.local
NOMOSMART_PUBLIC_ORIGIN=https://nomosmart.local
EDGE_HOST_IP=127.0.0.1
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_TLS_CERT_FILE=./deploy/docker/generated/current/tls/active/edge.crt
EDGE_TLS_KEY_FILE=./deploy/docker/generated/current/tls/active/edge.key
KEYCLOAK_ADMIN_ALLOW_CIDR=127.0.0.1/32
ONBOARDING_ADMIN_ALLOW_CIDR=127.0.0.1/32

# Application
APP_ENV=development
DEPLOYMENT_BOOTSTRAP_RELEASE=compose-local
DEPLOYMENT_PHASE=onboarding
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=https://nomosmart.local
FRONTEND_APP_ORIGIN=https://nomosmart.local
NEXT_PUBLIC_APP_ORIGIN=https://nomosmart.local
NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# PostgreSQL
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_DB=nomosmart
POSTGRES_USER=nomosmart
DATABASE_MIGRATION_USER=nomosmart
FLYWAY_JDBC_URL=jdbc:postgresql://postgresql:5432/nomosmart
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=nomosmart
KEYCLOAK_DB_URL=jdbc:postgresql://postgresql:5432/keycloak

# Redis / Celery
REDIS_USERNAME=nomosmart

# S3-compatible RustFS
S3_ENDPOINT_URL=https://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=nomosmart
S3_USE_SSL=true
S3_VERIFY_TLS=true
RUSTFS_TLS_CERT_FILE=./deploy/docker/generated/current/tls/active/rustfs.crt
RUSTFS_TLS_KEY_FILE=./deploy/docker/generated/current/tls/active/rustfs.key
RUSTFS_TLS_CA_FILE=./deploy/docker/generated/current/tls/active/rustfs-ca.crt
S3_CA_CERT_PATH=/etc/nomosmart/tls/rustfs-ca.crt
S3_PATH_STYLE_ACCESS=true

# OpenSearch
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USERNAME=nomosmart
OPENSEARCH_ADMIN_USERNAME=admin
OPENSEARCH_VERIFY_TLS=true
OPENSEARCH_TLS_CERT_FILE=./deploy/docker/generated/current/tls/active/opensearch.crt
OPENSEARCH_TLS_KEY_FILE=./deploy/docker/generated/current/tls/active/opensearch.key
OPENSEARCH_TLS_CA_FILE=./deploy/docker/generated/current/tls/active/opensearch-ca.crt
OPENSEARCH_CA_CERT_PATH=/etc/nomosmart/tls/opensearch-ca.crt
OPENSEARCH_INDEX_PREFIX=nomosmart-dev
OPENSEARCH_STAGING_LIVE_WRITE=true

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=nomosmart
NEO4J_ADMIN_USERNAME=neo4j
NEO4J_COMMUNITY_ADMIN_EQUIVALENT_ACCEPTED=true

# Keycloak / OIDC
KEYCLOAK_ADMIN=nomosmart
DEPLOYMENT_BOOTSTRAP_WAIT_SECONDS=300
OIDC_ISSUER_URL=https://nomosmart.local/identity/realms/nomosmart
OIDC_DISCOVERY_URL=http://keycloak:8080/identity/realms/nomosmart/.well-known/openid-configuration
OIDC_JWKS_URL=http://keycloak:8080/identity/realms/nomosmart/protocol/openid-connect/certs
OIDC_CLIENT_ID=nomosmart-backend
OIDC_AUDIENCE=nomosmart-backend
OIDC_FRONTEND_CLIENT_ID=nomosmart-frontend
NEXT_PUBLIC_OIDC_ISSUER_URL=https://nomosmart.local/identity/realms/nomosmart
NEXT_PUBLIC_OIDC_CLIENT_ID=nomosmart-frontend
NEXT_PUBLIC_OIDC_AUDIENCE=nomosmart-backend
FRONTEND_OIDC_INTERNAL_ISSUER_URL=http://keycloak:8080/identity/realms/nomosmart
KEYCLOAK_ADMIN_API_URL=https://nomosmart.local/identity
KEYCLOAK_ADMIN_INTERNAL_URL=http://keycloak:8080/identity
FRONTEND_EDGE_UPSTREAM=http://frontend:3000
KEYCLOAK_EDGE_UPSTREAM=http://keycloak:8080
KEYCLOAK_SYNC_CLIENT_ID=nomosmart-sync
KEYCLOAK_LDAP_GROUP_PATH=/ldap
BREAK_GLASS_USERNAME=nomosmart
BREAK_GLASS_RUNBOOK_URI=https://runbooks.example.test/nomosmart/break-glass
BREAK_GLASS_ALERTING_EVIDENCE=ops-alert-route
IDENTITY_SYNC_SCHEDULE=0 2 * * *
IDENTITY_SYNC_TIMEZONE=Asia/Taipei
IDENTITY_SYNC_ENABLED=true
IDENTITY_SYNC_SCOPE=people_and_groups
IDENTITY_SYNC_QUEUE_TIMEOUT_SECONDS=300
IDENTITY_SYNC_RUN_TIMEOUT_SECONDS=1800
IDENTITY_SYNC_HEARTBEAT_SECONDS=30
IDENTITY_SYNC_KEYCLOAK_PROVIDER_TIMEOUT_SECONDS=600

# Runtime defaults
DEFAULT_TIMEZONE=Asia/Taipei
NOMOSMART_DOCUMENT_MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_SIZE_MB=100
STAGING_INDEX_TTL_DAYS=7
TARGET_CHUNK_TOKENS=500
MAX_CHUNK_TOKENS=700
MIN_CHUNK_TOKENS=80
CHUNK_OVERLAP_TOKENS=60
HEADING_CONTEXT_ENABLED=true
MAX_HEADING_DEPTH=4
MAX_CONTEXT_PREFIX_TOKENS=96
DOCUMENT_TITLE_CONTEXT_ENABLED=true
TABLE_CHUNK_MAX_ROWS=10
REMOVE_REPEATED_HEADER_FOOTER=true
INGESTION_WORKER_LEASE_SECONDS=300
PANDOC_COMMAND=pandoc
PANDOC_SANDBOX_COMMAND=bwrap
PANDOC_TIMEOUT_SECONDS=120
PANDOC_MAX_MEMORY_MB=512
PANDOC_CACHE_DIR=/tmp/nomosmart-pandoc-cache
TESSERACT_COMMAND=tesseract
TESSERACT_PDF_COMMAND=pdftoppm
TESSERACT_SANDBOX_COMMAND=bwrap
TESSERACT_TIMEOUT_SECONDS=120
TESSERACT_MAX_MEMORY_MB=512
TESSERACT_MAX_PAGES=200
HTTP_SOURCE_ALLOWED_HOSTS=
HTTP_SOURCE_ALLOWED_CIDRS=
SFTP_KNOWN_HOSTS_PATH=/etc/nomosmart/ssh_known_hosts
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_API_INVALID_AUTH_REQUESTS_PER_MINUTE=20
PUBLIC_API_IDEMPOTENCY_TTL_HOURS=24
PUBLIC_API_IDEMPOTENCY_LEASE_SECONDS=300
PUBLIC_API_CONTENT_RETENTION_DAYS=30
PUBLIC_API_RECORD_RETENTION_DAYS=365
VALIDATION_MAX_ATTEMPTS=3
REPORT_EXPORT_BATCH_SIZE=500
REPORT_EXPORT_TIMEOUT_SECONDS=300
SFTP_KNOWN_HOSTS_FILE=./deploy/docker/ssh_known_hosts.example
