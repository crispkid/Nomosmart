      "mandatory": true,
      "verification_level": "live"
    },
    {
      "id": "oidc_login",
      "group": "identity",
      "requirement": "PROTAUTH-001..003/007/008/010",
      "behavior": "通用OIDC登入與issuer／audience／nonce／state／PKCE／replay拒絕",
      "mandatory": true,
      "verification_level": "live"
    },
    {
      "id": "session",
      "group": "identity",
      "requirement": "PROTAUTH-001..003/007/008/010",
      "behavior": "共用session、登出撤銷與30分鐘滑動閒置",
      "mandatory": true,
      "verification_level": "live"
    },
    {
      "id": "legacy_auth_denial",
      "group": "identity",
      "requirement": "PROTAUTH-001..003/007/008/010",
      "behavior": "舊標頭／外部Bearer不建立session；emergency限時及越權拒絕",
      "mandatory": true,
      "verification_level": "live"
    },
    {
      "id": "directory_sync",
